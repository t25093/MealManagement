<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

	<!-- טעינת ה-Layout Renderers של ASP.NET Core, למשל ${aspnet-TraceIdentifier} -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<variables>
		<!-- CorrelationId: קודם מה-scope שפותח CorrelationIdMiddleware.
         אם אין scope (למשל בלוג של ExceptionHandlingMiddleware, שיושב מחוצה לו),
         לוקחים מ-HttpContext.TraceIdentifier, שה-Middleware כבר הציב בו את אותו מזהה. -->
		<variable name="correlationId"
				  value="${scopeproperty:CorrelationId:whenEmpty=${aspnet-TraceIdentifier:ignoreActivityId=true:whenEmpty=-}}" />

		<variable name="lineLayout"
				  value="${longdate} | ${level:uppercase=true:padding=-5} | ${logger} | ${var:correlationId} | ${message}${onexception:inner=${newline}${exception:format=tostring}}" />
	</variables>

	<targets>
		<!-- 1. קובץ יומי: קובץ חדש לכל יום -->
		<target xsi:type="File" name="allFile"
				fileName="${basedir}/logs/app-${shortdate}.log"
				layout="${var:lineLayout}"
				encoding="utf-8" />

		<!-- 2. קובץ שגיאות נפרד: רק Error ומעלה -->
		<target xsi:type="File" name="errorFile"
				fileName="${basedir}/logs/errors-${shortdate}.log"
				layout="${var:lineLayout}"
				encoding="utf-8" />

		<!-- 3. Console: החלון השחור שנפתח בהרצה -->
		<target xsi:type="ColoredConsole" name="console"
				layout="${time} | ${level:uppercase=true:padding=-5} | ${logger:shortName=true} | ${var:correlationId} | ${message}${onexception:inner=${newline}${exception:format=tostring}}" />
	</targets>

	<rules>
		<!-- הרמה המינימלית נקבעת ב-appsettings (Logging:LogLevel), לכל סביבה בנפרד.
         כאן רק מחליטים לאן כל רמה נכתבת. -->
		<logger name="*" minlevel="Trace" writeTo="allFile,console" />
		<logger name="*" minlevel="Error" writeTo="errorFile" />
	</rules>
</nlog>
